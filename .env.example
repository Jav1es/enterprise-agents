# ===== Enterprise Agent 环境变量示例 =====
# 复制为 .env 并填入真实值：cp .env.example .env
# ⚠️ .env 已被 .gitignore 排除，严禁提交到 Git

# --- 应用 ---
APP_ENV=dev
LOG_LEVEL=info
API_PORT=8080

# --- LLM (OpenAI 兼容接口：OpenAI / DeepSeek / Qwen / Ollama) ---
LLM_API_KEY=YOUR_LLM_API_KEY
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o
LLM_FALLBACK_MODELS=qwen-max,deepseek-chat
LLM_MAX_CALLS=10

# --- 记忆层 ---
REDIS_URL=redis://localhost:6379/0
REDIS_SHORT_TERM_TTL=1800
DATABASE_URL=postgresql+asyncpg://agent:YOUR_DB_PASSWORD@localhost:5432/agent

# --- 知识层 (RAG) ---
VECTOR_STORE=chroma
CHROMA_PERSIST_DIR=./data/chroma
MILVUS_HOST=localhost
MILVUS_PORT=19530
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# --- 接入层 (企业系统凭证，示例留空) ---
DINGTALK_APP_KEY=YOUR_DINGTALK_APP_KEY
DINGTALK_APP_SECRET=YOUR_DINGTALK_APP_SECRET
WECOM_CORP_ID=YOUR_WECOM_CORP_ID
WECOM_AGENT_ID=YOUR_WECOM_AGENT_ID
WECOM_SECRET=YOUR_WECOM_SECRET
OA_API_URL=YOUR_OA_API_URL
OA_API_TOKEN=YOUR_OA_API_TOKEN
ERP_API_URL=YOUR_ERP_API_URL
ERP_API_TOKEN=YOUR_ERP_API_TOKEN

# --- API 安全 ---
API_KEY=YOUR_API_KEY
JWT_SECRET=YOUR_JWT_SECRET
