# ===== enterprise-agent-tools-mcp 环境变量示例 =====
# 复制为 .env 后填写真实值；未配置时自动使用 mock 示例数据（数据均标注"示例"），保证无 Key 可运行。

# --- ERP 域（可选，不配置则走 mock 降级） ---
ERP_API_URL=YOUR_ERP_API_URL
ERP_API_TOKEN=YOUR_ERP_API_TOKEN

# --- HTTP 域（可选，http_get / http_post 默认允许任意 URL；如需白名单可在此配置） ---
# HTTP_ALLOWED_HOSTS=YOUR_ALLOWED_HOSTS_COMMA_SEPARATED

# --- 日志级别（可选） ---
# LOG_LEVEL=INFO
