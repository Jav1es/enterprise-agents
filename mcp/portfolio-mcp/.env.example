# ===== portfolio-mcp 环境变量示例 =====
# 本项目为纯本地数据查询，默认无需任何环境变量即可运行（数据来自 portfolio_data.json 或内置示例数据）。
# 以下为可选配置项，复制为 .env 后按需填写。

# --- 日志级别（可选） ---
# LOG_LEVEL=INFO

# --- 数据文件路径覆盖（可选） ---
# 默认读取 src/portfolio_mcp/data/portfolio_data.json；
# 如需从其他位置加载数据，可在此指定绝对路径。
# PORTFOLIO_DATA_PATH=YOUR_PORTFOLIO_DATA_JSON_ABSOLUTE_PATH
