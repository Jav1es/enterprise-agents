# ===== rag-knowledge-base-mcp 环境变量示例 =====
# 本项目默认无需任何环境变量即可运行（BM25 检索 + 内置示例数据）。
# 以下为可选配置项，复制为 .env 后按需填写。

# --- LLM API Key（可选） ---
# 配置后 retrieve_with_evidence 会调用 LLM 生成答案（需在 server.py 的
# _generate_answer_with_llm 中接入你的 LLM 客户端实现）；
# 未配置时自动降级为纯 Top-K 检索结果，不发起任何外部请求。
# LLM_API_KEY=YOUR_LLM_API_KEY

# --- 日志级别（可选） ---
# LOG_LEVEL=INFO

# --- 文本切分参数（可选，默认 200 / 20） ---
# CHUNK_SIZE=200
# CHUNK_OVERLAP=20
